{
  "entities": {
    "Account": {
      "title": "Akun (COA)",
      "description": "Daftar Akun (Chart of Accounts) untuk sistem akuntansi.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Kode Akun (misal: 1101)" },
        "name": { "type": "string", "description": "Nama Akun" },
        "category": { "type": "string", "enum": ["Aset", "Liabilitas", "Ekuitas", "Pendapatan", "Beban"], "description": "Kategori Utama" },
        "subCategory": { "type": "string", "description": "Sub Kategori (misal: Kas, Bank, Piutang)" },
        "initialBalance": { "type": "number", "description": "Saldo Awal" },
        "isDeletable": { "type": "boolean", "description": "Apakah akun sistem yang tidak boleh dihapus" }
      },
      "required": ["code", "name", "category"]
    },
    "JournalEntry": {
      "title": "Jurnal Umum",
      "description": "Transaksi jurnal umum untuk pencatatan keuangan.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time", "description": "Tanggal Transaksi" },
        "description": { "type": "string", "description": "Keterangan Transaksi" },
        "reference": { "type": "string", "description": "Nomor Referensi/Bukti" },
        "lines": {
          "type": "array",
          "description": "Baris-baris jurnal (Debit & Kredit)"
        },
        "createdBy": { "type": "string", "description": "UID User pembuat" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Waktu Pembuatan" }
      },
      "required": ["date", "description", "lines", "createdBy", "createdAt"]
    },
    "Invoice": {
      "title": "Faktur",
      "description": "Faktur penagihan atau bukti donasi.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string", "description": "Nomor Faktur" },
        "recipient": { "type": "string", "description": "Nama Penerima/Donatur" },
        "date": { "type": "string", "format": "date-time", "description": "Tanggal Faktur" },
        "dueDate": { "type": "string", "format": "date-time", "description": "Tanggal Jatuh Tempo" },
        "items": { "type": "array", "description": "Item yang ditagihkan" },
        "total": { "type": "number", "description": "Total Nominal" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Paid", "Cancelled"], "description": "Status Faktur" },
        "notes": { "type": "string", "description": "Catatan tambahan" },
        "createdBy": { "type": "string", "description": "UID User pembuat" }
      },
      "required": ["invoiceNumber", "recipient", "date", "total", "status", "createdBy"]
    },
    "DebtReceivable": {
      "title": "Hutang & Piutang",
      "description": "Pencatatan transaksi hutang atau piutang termasuk uang muka, pembayaran, dan informasi umur.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["Hutang", "Piutang"], "description": "Tipe Transaksi" },
        "name": { "type": "string", "description": "Nama Debitur / Kreditur" },
        "date": { "type": "string", "format": "date-time", "description": "Tanggal Mulai Keuangan" },
        "dueDate": { "type": "string", "format": "date-time", "description": "Tanggal Jatuh Tempo" },
        "totalAmount": { "type": "number", "description": "Nominal Transaksi Asli (Rp)" },
        "downPayment": { "type": "number", "description": "Uang Muka / Uang Panjar awal" },
        "paidAmount": { "type": "number", "description": "Total Nominal yang Telah Dibayar melalui Cicilan" },
        "remainingBalance": { "type": "number", "description": "Sisa Sisa Hutang/Piutang" },
        "remarks": { "type": "string", "description": "Deskripsi / Memo penjelasan" },
        "status": { "type": "string", "enum": ["Belum Lunas", "Sebagian", "Lunas"], "description": "Status Terkini" },
        "payments": {
          "type": "array",
          "description": "Daftar riwayat pembayaran angsuran/pelunasan"
        },
        "createdBy": { "type": "string", "description": "UID User pembuat" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Waktu pembuatan data" },
        "isUangMuka": { "type": "boolean", "description": "Indikator jika transaksi ini adalah Panjar/Uang Muka (Cash Basis)" },
        "picName": { "type": "string", "description": "Nama Penanggung Jawab (PIC) atas uang muka" },
        "dpRefNumber": { "type": "string", "description": "Nomor Referensi Uang Muka" },
        "journalId": { "type": "string", "description": "ID Jurnal Umum terkait untuk sinkronisasi" }
      },
      "required": ["type", "name", "date", "dueDate", "totalAmount", "downPayment", "paidAmount", "remainingBalance", "status", "createdBy", "createdAt"]
    },
    "SystemSetting": {
      "title": "Pengaturan Sistem",
      "description": "Pengaturan administratif global untuk branding, mata uang, bahasa, dan visual aplikasi.",
      "type": "object",
      "properties": {
        "currency": { "type": "string", "enum": ["IDR", "USD", "EUR", "SGD", "GBP", "JPY"], "description": "Mata uang dasar" },
        "currencySymbol": { "type": "string", "description": "Simbol mata uang" },
        "language": { "type": "string", "enum": ["id", "en", "ar"], "description": "Bahasa operasional" },
        "fontFamily": { "type": "string", "enum": ["Inter", "Outfit", "Space Grotesk", "Playfair Display", "JetBrains Mono"], "description": "Jenis tipografi sistem" },
        "fontSize": { "type": "string", "enum": ["sm", "base", "lg"], "description": "Ukuran huruf sistem" },
        "systemName": { "type": "string", "description": "Nama sistem/institusi" },
        "systemSubName": { "type": "string", "description": "Slogan/Keterangan sistem" },
        "logoType": { "type": "string", "enum": ["school", "finance", "shield", "custom"], "description": "Tipe tampilan logo" },
        "customLogoUrl": { "type": "string", "description": "URL logo kustom" },
        "colorTheme": { "type": "string", "enum": ["original", "emerald", "indigo", "slate", "rose", "violet"], "description": "Skema warna utama" },
        "invoiceTemplate": { "type": "string", "enum": ["classic", "modern", "minimalist"], "description": "Desain templat faktur" }
      },
      "required": ["currency", "language", "fontFamily", "fontSize", "systemName", "systemSubName", "logoType", "colorTheme", "invoiceTemplate"]
    }
  },
  "firestore": {
    "accounts": {
      "schema": "Account",
      "description": "Koleksi Chart of Accounts."
    },
    "journal_entries": {
      "schema": "JournalEntry",
      "description": "Koleksi Jurnal Umum."
    },
    "invoices": {
      "schema": "Invoice",
      "description": "Koleksi Faktur."
    },
    "debts_receivables": {
      "schema": "DebtReceivable",
      "description": "Koleksi pencatatan hutang/piutang berjalan."
    },
    "system_settings": {
      "schema": "SystemSetting",
      "description": "Koleksi konfigurasi administratif global."
    }
  }
}
