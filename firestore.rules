rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.createdBy == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- COA (Accounts) ---
    function isValidAccount(data) {
      return data.code is string && data.code.size() <= 32 &&
             data.name is string && data.name.size() <= 100 &&
             data.category in ['Aset', 'Liabilitas', 'Ekuitas', 'Pendapatan', 'Beban'];
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidAccount(incoming());
      allow update: if isSignedIn() && isValidAccount(incoming());
      allow delete: if isSignedIn();
    }

    // --- Journal Entries ---
    function isValidJournalEntry(data) {
      return (data.date is timestamp || data.date is string) &&
             data.description is string && data.description.size() <= 1000 &&
             data.lines is list && data.lines.size() >= 2 &&
             data.createdBy == request.auth.uid &&
             (data.createdAt is timestamp || data.createdAt is string);
    }

    match /journal_entries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidJournalEntry(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidJournalEntry(incoming()) &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // --- Invoices ---
    function isValidInvoice(data) {
      return data.invoiceNumber is string && data.invoiceNumber.size() <= 64 &&
             data.recipient is string && data.recipient.size() <= 200 &&
             data.total is number && data.total >= 0 &&
             data.status in ['Draft', 'Sent', 'Paid', 'Cancelled'] &&
             data.createdBy == request.auth.uid;
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidInvoice(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidInvoice(incoming());
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // --- Debts & Receivables ---
    function isValidDebtReceivable(data) {
      return data.type in ['Hutang', 'Piutang'] &&
             data.name is string && data.name.size() <= 200 &&
             (data.date is timestamp || data.date is string) &&
             (data.dueDate is timestamp || data.dueDate is string) &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.downPayment is number && data.downPayment >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             data.remainingBalance is number && data.remainingBalance >= 0 &&
             data.status in ['Belum Lunas', 'Sebagian', 'Lunas'] &&
             data.payments is list &&
             data.createdBy == request.auth.uid &&
             (data.createdAt is timestamp || data.createdAt is string) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 1000)) &&
             (!('isUangMuka' in data) || data.isUangMuka is bool) &&
             (!('picName' in data) || (data.picName is string && data.picName.size() <= 300)) &&
             (!('dpRefNumber' in data) || (data.dpRefNumber is string && data.dpRefNumber.size() <= 100)) &&
             (!('journalId' in data) || (data.journalId is string && data.journalId.size() <= 100));
    }

    match /debts_receivables/{debtId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDebtReceivable(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidDebtReceivable(incoming());
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // --- System Settings ---
    function isValidSystemSetting(data) {
      return data.currency in ['IDR', 'USD', 'EUR', 'SGD', 'GBP', 'JPY'] &&
             data.language in ['id', 'en', 'ar'] &&
             data.fontFamily in ['Inter', 'Outfit', 'Space Grotesk', 'Playfair Display', 'JetBrains Mono'] &&
             data.fontSize in ['sm', 'base', 'lg'] &&
             data.systemName is string && data.systemName.size() <= 200 &&
             data.systemSubName is string && data.systemSubName.size() <= 400 &&
             data.logoType in ['school', 'finance', 'shield', 'custom'] &&
             data.colorTheme in ['original', 'emerald', 'indigo', 'slate', 'rose', 'violet'] &&
             data.invoiceTemplate in ['classic', 'modern', 'minimalist'] &&
             (!('customLogoUrl' in data) || (data.customLogoUrl is string && data.customLogoUrl.size() <= 2000)) &&
             (!('currencySymbol' in data) || (data.currencySymbol is string && data.currencySymbol.size() <= 8));
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(settingId) && isValidSystemSetting(incoming());
      allow update: if isSignedIn() && isValidId(settingId) && isValidSystemSetting(incoming());
      allow delete: if false;
    }

    // --- Deleted Records (Recycle Bin / Safety Feature) ---
    function isValidDeletedRecord(data) {
      return data.originalId is string && data.originalId.size() <= 128 &&
             data.originalCollection in ['journal_entries', 'debts_receivables', 'accounts'] &&
             (data.deletedAt is timestamp || data.deletedAt is string) &&
             data.deletedBy == request.auth.uid &&
             data.metadata is map &&
             data.data is map &&
             data.metadata.title is string && data.metadata.title.size() <= 1000 &&
             data.metadata.subtitle is string && data.metadata.subtitle.size() <= 1000;
    }

    match /deleted_records/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidDeletedRecord(incoming());
      allow update: if false; // Cannot modify deleted items
      allow delete: if isSignedIn();
    }
  }
}
